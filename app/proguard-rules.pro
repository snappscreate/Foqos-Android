# Add project specific ProGuard rules here.
# You can control the set of applied configuration files using the
# proguardFiles setting in build.gradle.kts.
#
# For more details, see
#   http://developer.android.com/guide/developing/tools/proguard.html

# --- Hilt / Dagger -------------------------------------------------------------------------
# Hilt ships its own consumer ProGuard rules (generated components, @Inject constructors, entry
# points) so no manual keep rules are required here.

# --- Room -----------------------------------------------------------------------------------
# Room's own consumer rules keep entities/DAOs generated by the annotation processor; no manual
# keep rules are required here.

# --- kotlinx.serialization --------------------------------------------------------------------
# The serialization plugin generates a synthetic `$serializer` companion/object per @Serializable
# class that R8 can't see reflectively-constructed references to. Keep our @Serializable model
# classes (and their generated serializers) so JSON encode/decode of profile/strategy/schedule
# data - persisted as JSON columns in Room - keeps working after minification.
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt

-keepclassmembers class kotlinx.serialization.json.** {
    *** Companion;
}
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Keep the generated serializer for every @Serializable class in our own model package plus its
# companion's `serializer()` factory function.
-keep,includedescriptorclasses class com.foqos.android.data.model.**$$serializer { *; }
-keepclassmembers class com.foqos.android.data.model.** {
    *** Companion;
}
-keepclasseswithmembers class com.foqos.android.data.model.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# --- ZXing (QR generation / scanning) ----------------------------------------------------------
-keep class com.google.zxing.** { *; }
-keep class com.journeyapps.barcodescanner.** { *; }
-dontwarn com.google.zxing.**

# --- Glance (app widget) ------------------------------------------------------------------------
# Glance composes RemoteViews at runtime via reflection-adjacent APIs in its own action/receiver
# classes; keep our widget entry points and Glance's generated action classes intact.
-keep class com.foqos.android.widget.** { *; }
-keep class androidx.glance.appwidget.** { *; }
-dontwarn androidx.glance.**

# --- DataStore Preferences (protobuf-lite) ------------------------------------------------------
# Found via release-build R8 smoke test: SettingsDataStore persists via androidx.datastore's
# Preferences implementation, which serializes to disk through a bundled protobuf-lite runtime
# (androidx.datastore.preferences.protobuf) PLUS a separate generated schema class
# (androidx.datastore.preferences.PreferencesProto, from the datastore-preferences-proto
# artifact - note: NOT under the .protobuf sub-package). GeneratedMessageLite looks up its own
# fields (e.g. "value_") by *name* via reflection when building/serializing a message, which R8
# renames unless told not to. This reproduced as a real crash on launch after onboarding
# ("java.lang.RuntimeException: Field value_ for K1.j not found") with isMinifyEnabled = true.
# A first attempt that only kept the .protobuf runtime package still crashed identically, because
# PreferencesProto (the class that actually owns "value_") lives one package up - both are kept
# below. Keeping the whole generated-proto surface (classes + members) fixes it.
-keep class androidx.datastore.preferences.protobuf.** { *; }
-keepclassmembers class androidx.datastore.preferences.protobuf.** { *; }
-dontwarn androidx.datastore.preferences.protobuf.**

-keep class androidx.datastore.preferences.PreferencesProto** { *; }
-keepclassmembers class androidx.datastore.preferences.PreferencesProto** { *; }
-dontwarn androidx.datastore.preferences.PreferencesProto**
