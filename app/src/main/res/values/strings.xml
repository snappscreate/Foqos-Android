<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Foqos</string>
    <string name="accessibility_service_description">Foqos reads only the package name of the app currently in the foreground, and - only inside the browsers it supports - the text shown in the address bar. This is used solely to block the apps and websites you selected in a focus profile. No data is collected, stored remotely, or transmitted anywhere; Foqos does not use the internet.</string>

    <!-- Permissions checklist (shared by Onboarding and Settings) -->
    <string name="permission_accessibility_title">Accessibility service</string>
    <string name="permission_accessibility_description">Lets Foqos detect and block the apps and websites in your active profile.</string>
    <string name="permission_usage_access_title">Usage access</string>
    <string name="permission_usage_access_description">Backup detection of the foreground app when accessibility is unavailable.</string>
    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_description">Needed to show the block screen on top of a blocked app.</string>
    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_description">Shows the ongoing focus-session status while blocking is active.</string>
    <string name="permission_exact_alarms_title">Exact alarms</string>
    <string name="permission_exact_alarms_description">Keeps timers, breaks and schedules firing precisely on time.</string>
    <string name="permission_battery_title">Battery optimization exemption</string>
    <string name="permission_battery_description">Prevents the system from killing Foqos while a session is active.</string>
    <string name="permission_nfc_title">NFC</string>
    <string name="permission_nfc_description">Required for NFC-tag based strategies.</string>
    <string name="permission_strongly_recommended">Strongly recommended</string>
    <string name="permission_fix_action">Fix</string>
    <string name="permission_app_info_action">App info</string>
    <string name="permission_restricted_settings_title">Toggle greyed out?</string>
    <string name="permission_restricted_settings_body">On Android 13+, open App info → tap ⋮ (top right) → \"Allow restricted settings\", then try again.</string>

    <!-- Onboarding -->
    <string name="onboarding_back">Back</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_tagline">Focus with intention</string>
    <string name="onboarding_welcome_body">Foqos helps you block distracting apps and websites on your own terms - start a focus session with a tap, an NFC tag, or a QR code, and stay off the apps that pull you away.</string>
    <string name="onboarding_features_title">What Foqos can do</string>
    <string name="onboarding_feature_strategies_title">NFC and QR strategies</string>
    <string name="onboarding_feature_strategies_body">Tap a tag or scan a code to start and stop a session - makes starting and stopping more deliberate.</string>
    <string name="onboarding_feature_schedules_title">Schedules</string>
    <string name="onboarding_feature_schedules_body">Set a weekly schedule so a profile blocks automatically at the same times every week.</string>
    <string name="onboarding_feature_insights_title">Insights</string>
    <string name="onboarding_feature_insights_body">Track your focus time with weekly, monthly and heatmap charts for every profile.</string>
    <string name="onboarding_permissions_title">Set up permissions</string>
    <string name="onboarding_permissions_body">Foqos needs a few permissions to actually block apps and websites. Accessibility and usage access are strongly recommended - the others improve reliability. You can continue and finish this later in Settings.</string>

