<?xml version="1.0" encoding="utf-8"?>
<!--
    Sized for a 2x1 minimum (matches ProfileWidget.SMALL_SIZE); resizable up to the 2x2
    MEDIUM_SIZE, which SizeMode.Responsive picks between at render time.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="100dp"
    android:minHeight="50dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="180dp"
    android:maxResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.foqos.android.widget.ProfileWidgetConfigActivity"
    android:description="@string/profile_widget_description"
    android:updatePeriodMillis="1800000" />
